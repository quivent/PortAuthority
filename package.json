{
  "name": "port-authority",
  "version": "1.0.0",
  "description": "Centralized port management system - zero conflicts, zero port stealing",
  "main": "service/index.js",
  "scripts": {
    "start": "node service/index.js",
    "dev": "nodemon service/index.js",
    "daemon": "node daemon.js start",
    "daemon:stop": "node daemon.js stop",
    "daemon:status": "node daemon.js status",
    "daemon:restart": "node daemon.js restart",
    "daemon:logs": "node daemon.js logs",
    "launchd:install": "cp com.portauthority.daemon.plist ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.portauthority.daemon.plist",
    "launchd:uninstall": "launchctl unload ~/Library/LaunchAgents/com.portauthority.daemon.plist && rm ~/Library/LaunchAgents/com.portauthority.daemon.plist",
    "launchd:restart": "launchctl kickstart -k gui/$(id -u)/com.portauthority.daemon",
    "setup": "npm install && cd cli && npm install && npm link && cd .. && node daemon.js start",
    "test": "jest"
  },
  "keywords": [
    "port",
    "management",
    "allocation",
    "service",
    "authority"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.2",
    "commander": "^11.1.0",
    "chalk": "^4.1.2",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0"
  }
}

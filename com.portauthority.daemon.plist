<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.portauthority.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/node</string>
        <string>/Users/joshkornreich/PortAuthority/service/index.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/joshkornreich/PortAuthority</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/joshkornreich/PortAuthority/.port-authority.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/joshkornreich/PortAuthority/.port-authority.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PORT_AUTHORITY_PORT</key>
        <string>9999</string>
    </dict>
</dict>
</plist>
